#!/usr/bin/env bash

# Credit to ThePrimeagen

if [[ $# -eq 1 ]]; then
    selected=$1
else
    items=`find ~/Projects -maxdepth 2 -mindepth 1 -type d`
    items+=`echo -e "\n/tmp"`
    selected=`echo "$items" | fzf`
fi

if [[ $selected == '' ]]; then
    exit
fi

dirname=`basename "$selected" | sed 's/\./_/g'`

tmux switch-client -t ="$dirname"
if [[ $? -eq 0 ]]; then
    exit 0
fi

# One flow per project: each session keeps its own flow state, server and master.
flow_home="$HOME/.local/state/flow/projects/$dirname"

tmux new-session -c "$selected" -e FLOW_HOME="$flow_home" -d -s "$dirname" && tmux switch-client -t "$dirname" || tmux new -c "$selected" -e FLOW_HOME="$flow_home" -A -s "$dirname"
